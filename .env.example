# ITER backend settings, for running the backend on your own computer.
# Copy this file to ".env" (same folder) and fill in the values.
# The real .env file is ignored by Git and must never be committed or shared.
#
# On the live site these are NOT read from a file: add the same names and values in
# Vercel -> your project -> Settings -> Environment Variables.

# Anthropic API key used for receipt scanning and menu translation.
# Get one at https://console.anthropic.com -> API keys. It lives ONLY on the server.
ANTHROPIC_API_KEY=
