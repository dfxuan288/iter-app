# ITER server settings.
# Copy this file to ".env" (same folder) and fill in the values.
# The real .env file is ignored by Git and must never be committed or shared.

# Anthropic API key used for receipt scanning and menu translation.
# Get one at https://console.anthropic.com -> API keys. It lives ONLY on the server.
ANTHROPIC_API_KEY=

# Port the server listens on inside its container.
PORT=8080

# Web addresses allowed to call the API, comma-separated. "*" allows any (fine for local testing).
# On the real server set this to the app's address, e.g. https://iter.example.edu.my
CORS_ORIGIN=*
