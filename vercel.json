{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install && npm --prefix mobile ci",
  "buildCommand": "npm --prefix mobile run build:web",
  "outputDirectory": "mobile/dist",
  "cleanUrls": true,
  "regions": ["sin1"],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/" }]
}
